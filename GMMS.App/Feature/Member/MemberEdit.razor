@using MudBlazor

<MudDialog MaxWidth="MaxWidth.Small" FullWidth="true">
    <TitleContent>
        <MudText Typo="Typo.h6" Class="gmm-member__edit-title">
            <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-3" Color="Color.Primary" /> Edit Member
        </MudText>
    </TitleContent>

    <DialogContent>
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
        }

        @if (isLoading)
        {
            <div class="d-flex flex-column gmm-member__edit-skeleton">
                <MudSkeleton Height="56px" />
                <MudSkeleton Height="56px" />
            </div>
        }
        else if (loadFailed)
        {
            <div class="d-flex flex-column align-center pa-4">
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3" Style="text-align: center;">
                    We couldn't load this member. Check your connection, then try again.
                </MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RetryAsync"
                           StartIcon="@Icons.Material.Filled.Refresh">
                    Try Again
                </MudButton>
            </div>
        }
        else if (member is not null)
        {
            <MudTextField @bind-Value="request.MemberCode"
                          @bind-Value:after="ConvertMemberCodeUpper"
                          Label="Member Code"
                          Variant="Variant.Outlined"
                          Required="true"
                          RequiredError="Member Code is required."
                          MaxLength="50"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Badge"
                          Class="mb-3 gmm-field-constrained"
                          HelperText="Uppercase letters, numbers, and hyphens only (max 50 chars)" />

            <MudTextField @bind-Value="request.Name"
                          Label="Name"
                          Variant="Variant.Outlined"
                          Required="true"
                          RequiredError="Name is required."
                          MaxLength="100"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Person"
                          Class="mb-3 gmm-field-constrained"
                          HelperText="Max 100 characters" />

            @if (AuthTokenStore.CurrentUser?.Role == AuthTokenStore.RoleOwner)
            {
                <MudDivider Class="my-4" />

                <MudText Typo="Typo.subtitle2" Class="mb-2 gmm-member__edit-label">Timestamps</MudText>

                <MudTextField Value="@member.CreatedAt.FormatMmtDateTime()" Label="Created At" Variant="Variant.Outlined"
                              ReadOnly="true" Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.CalendarToday" Class="mb-3" />

                <MudTextField Value="@(string.IsNullOrEmpty(member.CreatedByUser) ? "-" : member.CreatedByUser)" Label="Created By" Variant="Variant.Outlined"
                              ReadOnly="true" Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Person" Class="mb-3" />

                @if (member.UpdatedAt is not null || !string.IsNullOrEmpty(member.UpdatedByUser))
                {
                    <MudTextField Value="@member.UpdatedAt.FormatMmtDateTime()" Label="Updated At" Variant="Variant.Outlined"
                                  ReadOnly="true" Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.CalendarToday" Class="mb-3" />

                    <MudTextField Value="@(string.IsNullOrEmpty(member.UpdatedByUser) ? "-" : member.UpdatedByUser)" Label="Updated By" Variant="Variant.Outlined"
                                  ReadOnly="true" Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Person" Class="mb-3" />
                }
            }
        }
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text" Class="mr-2">Cancel</MudButton>
        <MudButton OnClick="Update"
                   Variant="Variant.Filled"
                   Class="gmm-member__edit-save"
                   StartIcon="@Icons.Material.Filled.Save"
                   Disabled="@(isSaving || loadFailed || member is null)">
            @if (isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Update
        </MudButton>
    </DialogActions>
</MudDialog>

<style>
    .gmm-member__edit-title {
        font-weight: 700 !important;
    }

    .gmm-member__edit-label {
        color: var(--mud-palette-text-secondary);
    }

    .gmm-member__edit-skeleton {
        gap: 16px;
    }

    .gmm-member__edit-save {
        background-color: #10B981;
        border-radius: 8px;
    }

    .gmm-member__edit-save:hover {
        filter: brightness(1.15);
    }

    .gmm-field-constrained {
        flex: 0 1 320px !important;
        min-width: 200px !important;
        max-width: 320px !important;
        width: auto !important;
    }
</style>
