@using MudBlazor

<MudDialog MaxWidth="MaxWidth.Small" FullWidth="true">
    <TitleContent>
        <MudText Typo="Typo.h6" Class="gmm-member__delete-title">
            <MudIcon Icon="@Icons.Material.Filled.Delete" Class="mr-3" Color="Color.Error" /> Delete Member
        </MudText>
    </TitleContent>

    <DialogContent>
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
        }

        @if (isLoading)
        {
            <div class="d-flex flex-column gmm-member__delete-skeleton">
                <MudSkeleton Height="56px" />
                <MudSkeleton Height="56px" />
                <MudSkeleton Height="56px" />
            </div>
        }
        else if (loadFailed)
        {
            <div class="d-flex flex-column align-center pa-4">
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3" Style="text-align: center;">
                    We couldn't load this member. Check your connection, then try again.
                </MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RetryAsync"
                           StartIcon="@Icons.Material.Filled.Refresh">
                    Try Again
                </MudButton>
            </div>
        }
        else if (member is not null)
        {
            <MudTextField Value="@member.Name" Label="Name" Variant="Variant.Outlined" ReadOnly="true"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Person" Class="mb-3" />

            <MudTextField Value="@member.MemberCode" Label="Member Code" Variant="Variant.Outlined" ReadOnly="true"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Badge" Class="mb-3" />

            <MudTextField Value="@member.CreatedAt.ToString("yyyy-MM-dd HH:mm")" Label="Created At" Variant="Variant.Outlined" ReadOnly="true"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.CalendarToday" Class="mb-4" />

            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4">
                <div class="d-flex flex-column" style="gap: 4px;">
                    <span><strong>This action cannot be undone.</strong></span>
                    <span>All memberships for this member will also be deleted.</span>
                    <span>Associated payments will be preserved for records.</span>
                </div>
            </MudAlert>

            <MudCheckBox @bind-Value="confirmed" Color="Color.Error" Class="gmm-member__delete-confirm"
                         Label="I understand this will permanently delete this member and their memberships." />
        }
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text" Class="mr-2">Cancel</MudButton>
        <MudButton OnClick="ConfirmDelete"
                   Variant="Variant.Filled"
                   Color="Color.Error"
                   Class="gmm-member__delete-btn"
                   Disabled="@(isDeleting || !confirmed || member is null)">
            @if (isDeleting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Yes, Delete
        </MudButton>
    </DialogActions>
</MudDialog>

<style>
    .gmm-member__delete-title {
        font-weight: 700 !important;
    }

    .gmm-member__delete-skeleton {
        gap: 16px;
    }

    .gmm-member__delete-confirm {
        margin-top: 4px;
    }

    .gmm-member__delete-btn {
        border-radius: 8px;
    }
</style>
