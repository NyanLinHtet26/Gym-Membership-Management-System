@inject AuthTokenStore AuthTokenStore
@inject ApiService ApiService
@inject NavigationManager Navigation

<MudPaper Width="250px" Elevation="0" Class="gmm-nav-dark d-flex flex-column" Style="background-color: transparent; color: #fff; height:100%;">
    <MudNavMenu Rounded="true" Margin="Margin.Dense" Color="Color.Primary" Class="pa-2">
        <MudNavLink Href="member-list" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.People">Members</MudNavLink>
        <MudNavLink Href="membership-list-all" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.HowToReg">All Memberships</MudNavLink>
        <MudNavLink Href="membershipplan-list" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Book">Membership Plans</MudNavLink>
        <MudNavLink Href="paymentmethod-list" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Wallet">Payment Methods</MudNavLink>
        <MudNavLink Href="payment-list" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Receipt">Payments</MudNavLink>
        @if (AuthTokenStore.CurrentUser?.Role == "Owner")
        {
            <MudNavLink Href="user-list" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AdminPanelSettings">Users</MudNavLink>
        }
    </MudNavMenu>
    <MudMenu AnchorOrigin="Origin.TopLeft" TransformOrigin="Origin.BottomLeft" Class="mt-auto" Style="width:100%;">
        <ActivatorContent>
            <div class="d-flex align-center justify-space-between px-3 py-2 gmm-nav-avatar" @onclick="context.ToggleAsync">
                <div class="d-flex align-center">
                    <MudAvatar Size="Size.Small" Color="Color.Primary" Class="mr-3">@Initial</MudAvatar>
                    <div>
                        <MudText Typo="Typo.body2">@AuthTokenStore.CurrentUser?.UserName</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@AuthTokenStore.CurrentUser?.Role</MudText>
                    </div>
                </div>
                <MudIcon Icon="@Icons.Material.Filled.ArrowDropDown" Size="Size.Small" />
            </div>
        </ActivatorContent>
        <ChildContent>
            <MudMenuItem OnClick="GoToChangePassword" Icon="@Icons.Material.Filled.LockReset">Change Password</MudMenuItem>
            <MudMenuItem OnClick="HandleLogout" Icon="@Icons.Material.Filled.Logout">Logout</MudMenuItem>
        </ChildContent>
    </MudMenu>
</MudPaper>

<style>
    .gmm-nav-avatar {
        cursor: pointer;
        border-radius: 8px;
        transition: background-color 0.15s ease;
    }

    .gmm-nav-avatar:hover {
        background-color: var(--mud-palette-action-hover);
    }

    .gmm-nav-dark .mud-nav-link {
        color: rgba(255, 255, 255, 0.7);
    }

    .gmm-nav-dark .mud-nav-link:hover {
        color: #fff;
        background-color: rgba(255, 255, 255, 0.08);
    }

    .gmm-nav-dark .mud-nav-link.active,
    .gmm-nav-dark .mud-nav-link.active:hover {
        background-color: #DC2626;
        color: #fff;
    }

    .gmm-nav-dark .mud-text-secondary {
        color: rgba(255, 255, 255, 0.6);
    }

    .gmm-nav-dark .gmm-nav-avatar:hover {
        background-color: rgba(255, 255, 255, 0.08);
    }
</style>

@code {
    private string Initial => AuthTokenStore.CurrentUser?.UserName is { Length: > 0 } name
        ? name[..1].ToUpperInvariant()
        : "?";

    private void GoToChangePassword()
    {
        Navigation.NavigateTo("/change-password");
    }

    private async Task HandleLogout()
    {
        try
        {
            await ApiService.LogoutAsync<object>();
        }
        catch
        {
        }
        AuthTokenStore.Clear();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
