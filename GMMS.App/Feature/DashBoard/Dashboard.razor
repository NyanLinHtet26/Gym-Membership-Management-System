@page "/"

<MudContainer MaxWidth="MaxWidth.Large">
    <div class="gmm-dash__head">
        <div>
            <MudText Typo="Typo.h4" Class="gmm-dash__title">Dashboard</MudText>
            <MudText Typo="Typo.body2" Class="gmm-dash__subtitle">@DateTime.Today.ToString("dddd, MMMM d, yyyy")</MudText>
        </div>
        <MudTooltip Text="Refresh data">
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="MudBlazor.Color.Primary"
                           OnClick="RetryAsync" Class="gmm-dash__refresh" aria-label="Refresh dashboard data" />
        </MudTooltip>
    </div>

    @if (_isLoading)
    {
        <div class="gmm-dash__stats">
            @for (var i = 0; i < 4; i++)
            {
                <MudPaper Elevation="0" Outlined="true" Class="gmm-dash__stat gmm-dash__stat--skeleton">
                    <MudSkeleton Variant="SkeletonVariant.Circle" Width="44px" Height="44px" />
                    <div class="d-flex flex-column" style="gap: 6px;">
                        <MudSkeleton Width="90px" Height="12px" />
                        <MudSkeleton Width="130px" Height="22px" />
                    </div>
                </MudPaper>
            }
        </div>
        <div class="gmm-dash__charts">
            @for (var i = 0; i < 2; i++)
            {
                <MudPaper Elevation="0" Outlined="true" Class="gmm-dash__card">
                    <MudSkeleton Width="160px" Height="20px" />
                    <MudSkeleton Width="220px" Height="12px" Class="mt-1" />
                    <MudSkeleton Height="240px" Class="gmm-dash__chart-skeleton" />
                </MudPaper>
            }
        </div>
    }
    else if (_errorMessage is not null)
    {
        <MudPaper Elevation="0" Outlined="true" Class="gmm-dash__error pa-6 d-flex flex-column align-center">
            <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="MudBlazor.Size.Large" Class="mud-text-secondary mb-3" />
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="w-100">
                @_errorMessage
            </MudAlert>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-3">
                Check your connection to the server, then try again.
            </MudText>
            <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" Class="gmm-dash__retry mt-4"
                       OnClick="RetryAsync" StartIcon="@Icons.Material.Filled.Refresh">
                Try Again
            </MudButton>
        </MudPaper>
    }
    else if (_model is not null)
    {
        <div class="gmm-dash__stats">
            <div class="gmm-dash__stat gmm-dash__stat--violet">
                <div class="gmm-dash__stat-icon">
                    <MudIcon Icon="@Icons.Material.Filled.People" />
                </div>
                <div class="gmm-dash__stat-body">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary gmm-dash__stat-label">Total Members</MudText>
                    <MudText Typo="Typo.h5" Class="gmm-dash__stat-value">@_model.TotalMembers.ToString("N0")</MudText>
                    @if (_memberDelta != 0)
                    {
                        <MudText Typo="Typo.caption" Class="@GetMemberTrendClass()">
                            <MudIcon Icon="@(_memberDelta > 0 ? Icons.Material.Filled.ArrowUpward : Icons.Material.Filled.ArrowDownward)" Size="MudBlazor.Size.Small" />
                            @Math.Abs(_memberDelta).ToString("N0") this month
                        </MudText>
                    }
                </div>
            </div>

            <div class="gmm-dash__stat gmm-dash__stat--green">
                <div class="gmm-dash__stat-icon">
                    <MudIcon Icon="@Icons.Material.Filled.Paid" />
                </div>
                <div class="gmm-dash__stat-body">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary gmm-dash__stat-label">Today's Income</MudText>
                    <MudText Typo="Typo.h5" Class="gmm-dash__stat-value">@_model.TodayIncome.ToString("C2")</MudText>
                </div>
            </div>

            <div class="gmm-dash__stat gmm-dash__stat--blue">
                <div class="gmm-dash__stat-icon">
                    <MudIcon Icon="@Icons.Material.Filled.TrendingUp" />
                </div>
                <div class="gmm-dash__stat-body">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary gmm-dash__stat-label">Monthly Revenue</MudText>
                    <MudText Typo="Typo.h5" Class="gmm-dash__stat-value">@_model.MonthlyRevenue.ToString("C2")</MudText>
                    @if (_revenueTrendPercent is { } pct)
                    {
                        <MudText Typo="Typo.caption" Class="@GetRevenueTrendClass()">
                            <MudIcon Icon="@(pct >= 0 ? Icons.Material.Filled.ArrowUpward : Icons.Material.Filled.ArrowDownward)" Size="MudBlazor.Size.Small" />
                            @Math.Abs(pct).ToString("0.0")% vs last month
                        </MudText>
                    }
                </div>
            </div>

            <div class="gmm-dash__stat gmm-dash__stat--amber">
                <div class="gmm-dash__stat-icon">
                    <MudIcon Icon="@Icons.Material.Filled.Star" />
                </div>
                <div class="gmm-dash__stat-body">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary gmm-dash__stat-label">Most Popular Plan</MudText>
                    <MudText Typo="Typo.h5" Class="gmm-dash__stat-value gmm-dash__stat-value--plan">@_topPlanName</MudText>
                    @if (_topPlanCount > 0)
                    {
                        <MudText Typo="Typo.caption" Class="gmm-dash__trend gmm-dash__trend--neutral">
                            <MudIcon Icon="@Icons.Material.Filled.Group" Size="MudBlazor.Size.Small" />
                            @_topPlanCount.ToString("N0") members
                        </MudText>
                    }
                </div>
            </div>
        </div>

        <MudGrid>
            <MudItem xs="12" md="6">
                <MudPaper Elevation="0" Outlined="true" Class="gmm-dash__card">
                    <MudText Typo="Typo.h6" Class="gmm-dash__card-title">Member Growth</MudText>
                    <MudText Typo="Typo.body2" Class="gmm-dash__card-subtitle">Total members over the last 6 months</MudText>
                    <ApexChart TItem="ChartPoint" Options="_memberGrowthOptions" Height="260">
                        <ApexPointSeries TItem="ChartPoint" Items="_memberGrowthPoints" Name="Total Members"
                                         SeriesType="SeriesType.Line" XValue="e => e.X" YValue="e => e.Y" />
                    </ApexChart>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudPaper Elevation="0" Outlined="true" Class="gmm-dash__card">
                    <MudText Typo="Typo.h6" Class="gmm-dash__card-title">Monthly Revenue Trend</MudText>
                    <MudText Typo="Typo.body2" Class="gmm-dash__card-subtitle">Revenue earned per month</MudText>
                    <ApexChart TItem="ChartPoint" Options="_revenueTrendOptions" Height="260">
                        <ApexPointSeries TItem="ChartPoint" Items="_revenueTrendPoints" Name="Revenue"
                                         SeriesType="SeriesType.Line" XValue="e => e.X" YValue="e => e.Y" />
                    </ApexChart>
                </MudPaper>
            </MudItem>
            <MudItem xs="12">
                <MudPaper Elevation="0" Outlined="true" Class="gmm-dash__card">
                    <MudText Typo="Typo.h6" Class="gmm-dash__card-title">Most Used Plans</MudText>
                    <MudText Typo="Typo.body2" Class="gmm-dash__card-subtitle">Members per plan, ranked</MudText>
                    <ApexChart TItem="ChartPoint" Options="_planUsageOptions" Height="220">
                        <ApexPointSeries TItem="ChartPoint" Items="_planUsagePoints" Name="Members"
                                         SeriesType="SeriesType.Bar" XValue="e => e.X" YValue="e => e.Y" />
                    </ApexChart>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
    else
    {
        <MudPaper Elevation="0" Outlined="true" Class="gmm-dash__empty pa-8 d-flex flex-column align-center">
            <MudIcon Icon="@Icons.Material.Filled.Insights" Size="MudBlazor.Size.Large" Class="mud-text-secondary mb-3" />
            <MudText Typo="Typo.body1" Class="mb-1"><strong>No dashboard data yet</strong></MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="text-align: center; max-width: 420px;">
                Add members and record payments to see your gym's stats here.
            </MudText>
        </MudPaper>
    }
</MudContainer>

<style>
    .gmm-dash__head {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 20px;
    }

    .gmm-dash__title {
        font-weight: 700 !important;
        text-wrap: balance;
    }

    .gmm-dash__subtitle {
        color: var(--mud-palette-text-secondary);
        text-wrap: pretty;
    }

    .gmm-dash__refresh {
        border-radius: 8px;
    }

    .gmm-dash__stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
        gap: 16px;
        margin-bottom: 16px;
    }

    .gmm-dash__stat {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 18px 20px;
        border-radius: 14px;
        border: 1px solid var(--mud-palette-lines-default);
        background-color: var(--mud-palette-surface);
    }

    .gmm-dash__stat--skeleton {
        min-height: 84px;
    }

    .gmm-dash__stat-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        border-radius: 12px;
        flex: 0 0 44px;
    }

    .gmm-dash__stat--violet .gmm-dash__stat-icon {
        background-color: rgba(124, 58, 237, 0.14);
        color: #A78BFA;
    }

    .gmm-dash__stat--green .gmm-dash__stat-icon {
        background-color: rgba(16, 185, 129, 0.14);
        color: #10B981;
    }

    .gmm-dash__stat--blue .gmm-dash__stat-icon {
        background-color: rgba(59, 130, 246, 0.14);
        color: #60A5FA;
    }

    .gmm-dash__stat--amber .gmm-dash__stat-icon {
        background-color: rgba(245, 158, 11, 0.14);
        color: #F59E0B;
    }

    .gmm-dash__stat-body {
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .gmm-dash__stat-value {
        margin: 0;
        line-height: 1.2;
        font-variant-numeric: tabular-nums;
    }

    .gmm-dash__stat-value--plan {
        font-size: 1.05rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .gmm-dash__trend {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-weight: 600;
        line-height: 1.4;
    }

    .gmm-dash__trend--up {
        color: #10B981;
    }

    .gmm-dash__trend--down {
        color: #EF4444;
    }

    .gmm-dash__trend--neutral {
        color: var(--mud-palette-text-secondary);
    }

    .gmm-dash__card {
        border-radius: 14px;
        padding: 20px 20px 8px;
        height: 100%;
    }

    .gmm-dash__card-title {
        font-weight: 600 !important;
        margin-bottom: 2px;
    }

    .gmm-dash__card-subtitle {
        color: var(--mud-palette-text-secondary);
        margin-bottom: 8px;
    }

    .gmm-dash__chart-skeleton {
        margin-top: 16px;
        border-radius: 8px;
    }

    .gmm-dash__error {
        margin-top: 8px;
        border-radius: 12px;
    }

    .gmm-dash__retry {
        border-radius: 8px;
    }

    .gmm-dash__empty {
        margin-top: 24px;
        border-radius: 12px;
    }
</style>
