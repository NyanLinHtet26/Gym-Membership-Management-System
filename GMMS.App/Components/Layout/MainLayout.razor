@inherits LayoutComponentBase
@inject AuthTokenStore AuthTokenStore
@inject NavigationManager Navigation
@inject ApiService ApiService

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@(e => DrawerToggle())" />
        <MudText Typo="Typo.subtitle1" Class="ml-2">
            Gym Management System
        </MudText>
        <MudSpacer />
        @if (AuthTokenStore.IsLoggedIn)
        {
            <MudText Typo="Typo.body2" Class="mr-4 mud-primary-text">
                @AuthTokenStore.CurrentUser?.UserName (@AuthTokenStore.CurrentUser?.Role)
            </MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" OnClick="HandleLogout" />
        }
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" Elevation="2">
        <MudDrawerHeader>
            <MudText Typo="Typo.h5" Class="mt-1">GMMS</MudText>
        </MudDrawerHeader>
        @if (AuthTokenStore.IsLoggedIn)
        {
            <NavMenu />
        }
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="py-8">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    bool _drawerOpen = true;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            var uri = Navigation.Uri;
            if (!AuthTokenStore.IsLoggedIn &&
                !uri.Contains("/login", StringComparison.OrdinalIgnoreCase) &&
                !uri.Contains("/change-password", StringComparison.OrdinalIgnoreCase))
            {
                Navigation.NavigateTo("/login", forceLoad: true);
            }
        }
    }

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private async Task HandleLogout()
    {
        try
        {
            await ApiService.LogoutAsync<object>();
        }
        catch
        {
        }
        AuthTokenStore.Clear();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
