@using MudBlazor

<MudDialog MaxWidth="MaxWidth.Small" FullWidth="true">
    <TitleContent>
        <MudText Typo="Typo.h6" Class="gmm-pay__detail-title">
            <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Class="mr-3" Color="Color.Primary" /> Payment Details
        </MudText>
    </TitleContent>

    <DialogContent>
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
        }

        @if (isLoading)
        {
            <div class="d-flex flex-column gmm-pay__detail-skeleton">
                <MudSkeleton Height="90px" />
                <MudSkeleton Height="56px" />
                <MudSkeleton Height="56px" />
            </div>
        }
        else if (loadFailed)
        {
            <div class="d-flex flex-column align-center pa-4">
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3" Style="text-align: center;">
                    We couldn't load this payment. Check your connection, then try again.
                </MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RetryAsync"
                           StartIcon="@Icons.Material.Filled.Refresh">
                    Try Again
                </MudButton>
            </div>
        }
        else if (detail is not null)
        {
            <div class="d-flex flex-wrap align-center justify-space-between mb-3">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Class="gmm-pay__detail-id">
                    Payment #@detail.PaymentId
                </MudChip>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                         Color="@GetStatusColor(detail.Status)" Class="gmm-pay__detail-chip">
                    @detail.Status
                </MudChip>
            </div>

            <div class="gmm-pay__detail-receipt mb-4">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Amount</MudText>
                <MudText Typo="Typo.h4" Class="gmm-pay__detail-amount">@detail.Amount.ToString("C2")</MudText>
                <MudText Typo="Typo.caption" Class="gmm-pay__detail-paid-on">@detail.CreatedAt.ToString("yyyy-MM-dd HH:mm")</MudText>
            </div>

            <div class="gmm-pay__detail-card">
                <div class="gmm-pay__detail-row">
                    <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Class="gmm-pay__detail-row-icon" />
                    <div>
                        <MudText Typo="Typo.caption" Class="gmm-pay__detail-row-label">Member</MudText>
                        <MudText Typo="Typo.body1">@detail.MemberName</MudText>
                    </div>
                </div>
                <div class="gmm-pay__detail-row">
                    <MudIcon Icon="@Icons.Material.Filled.CardMembership" Size="Size.Small" Class="gmm-pay__detail-row-icon" />
                    <div>
                        <MudText Typo="Typo.caption" Class="gmm-pay__detail-row-label">Membership</MudText>
                        <MudText Typo="Typo.body1">@detail.MembershipName</MudText>
                    </div>
                </div>
                <div class="gmm-pay__detail-row">
                    <MudIcon Icon="@Icons.Material.Filled.Wallet" Size="Size.Small" Class="gmm-pay__detail-row-icon" />
                    <div>
                        <MudText Typo="Typo.caption" Class="gmm-pay__detail-row-label">Payment Method</MudText>
                        <MudText Typo="Typo.body1">@detail.PaymentMethodName</MudText>
                    </div>
                </div>
                <div class="gmm-pay__detail-row">
                    <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Class="gmm-pay__detail-row-icon" />
                    <div>
                        <MudText Typo="Typo.caption" Class="gmm-pay__detail-row-label">Created At</MudText>
                        <MudText Typo="Typo.body1">@detail.CreatedAt.ToString("yyyy-MM-dd HH:mm")</MudText>
                    </div>
                </div>
                @if (AuthTokenStore.CurrentUser?.Role == "Owner")
                {
                    <div class="gmm-pay__detail-row">
                        <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Size="Size.Small" Class="gmm-pay__detail-row-icon" />
                        <div>
                            <MudText Typo="Typo.caption" Class="gmm-pay__detail-row-label">Created By</MudText>
                            <MudText Typo="Typo.body1">@(string.IsNullOrEmpty(detail.CreatedByUser) ? "-" : detail.CreatedByUser)</MudText>
                        </div>
                    </div>
                }
            </div>
        }
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Close</MudButton>
    </DialogActions>
</MudDialog>

<style>
    .gmm-pay__detail-title {
        font-weight: 700 !important;
    }

    .gmm-pay__detail-skeleton {
        gap: 16px;
    }

    .gmm-pay__detail-id.mud-chip {
        background-color: var(--mud-palette-background-grey);
        color: var(--mud-palette-text-primary);
        border-left: 3px solid #F59E0B;
        border-radius: 6px;
        font-family: 'Cascadia Mono', 'Consolas', monospace;
        letter-spacing: .3px;
    }

    .gmm-pay__detail-chip {
        border-radius: 6px;
    }

    .gmm-pay__detail-receipt {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        padding: 20px 16px;
        border-radius: 12px;
        border: 1px solid var(--mud-palette-lines-default);
        background-color: var(--mud-palette-surface);
    }

    .gmm-pay__detail-amount {
        font-weight: 700 !important;
        color: #10B981;
        margin: 0;
        font-variant-numeric: tabular-nums;
    }

    .gmm-pay__detail-paid-on {
        color: var(--mud-palette-text-secondary);
    }

    .gmm-pay__detail-card {
        border-radius: 12px;
        border: 1px solid var(--mud-palette-lines-default);
        background-color: var(--mud-palette-surface);
        overflow: hidden;
    }

    .gmm-pay__detail-row {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 12px 16px;
    }

    .gmm-pay__detail-row + .gmm-pay__detail-row {
        border-top: 1px solid var(--mud-palette-lines-default);
    }

    .gmm-pay__detail-row-icon {
        color: var(--mud-palette-text-secondary);
        flex: 0 0 auto;
    }

    .gmm-pay__detail-row-label {
        color: var(--mud-palette-text-secondary);
        line-height: 1.2;
    }

    .gmm-pay__detail-row > div > .mud-typography-body1 {
        margin: 0;
        word-break: break-word;
    }
</style>
