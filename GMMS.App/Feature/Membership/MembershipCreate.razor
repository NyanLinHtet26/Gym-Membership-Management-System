@using MudBlazor
@using GMMS.App.Services

<MudDialog MaxWidth="MaxWidth.Small" FullWidth="true">
    <TitleContent>
        <MudText Typo="Typo.h6" Class="gmm-ms__create-title">
            <MudIcon Icon="@Icons.Material.Filled.AddCard" Class="mr-3" Color="Color.Primary" /> Create Membership
        </MudText>
    </TitleContent>

    <DialogContent>
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
        }

        @if (isLoadingData)
        {
            <div class="d-flex flex-column gmm-ms__create-skeleton">
                <MudSkeleton Height="56px" />
                <MudSkeleton Height="56px" />
                <MudSkeleton Height="56px" />
            </div>
        }
        else if (loadFailed)
        {
            <div class="d-flex flex-column align-center pa-4">
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3" Style="text-align: center;">
                    We couldn't load the data needed to create a membership. Check your connection, then try again.
                </MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RetryAsync"
                           StartIcon="@Icons.Material.Filled.Refresh">
                    Try Again
                </MudButton>
            </div>
        }
        else
        {
            @if (MemberId > 0 && selectedMemberName is not null)
            {
                <MudTextField Value="@selectedMemberName" Label="Member" Variant="Variant.Outlined"
                              ReadOnly="true" Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Person" Class="gmm-field-constrained mb-4" />
            }
            else
            {
                <MudSelect T="int" Value="@request.MemberId" ValueChanged="@OnMemberValueChanged"
                           Label="Member" Variant="Variant.Outlined" Required="true"
                           RequiredError="Please select a member."
                           AnchorOrigin="Origin.BottomCenter" Class="gmm-field-constrained mb-4"
                           HelperText="Select the member joining this plan.">
                    @foreach (var m in members)
                    {
                        <MudSelectItem Value="@(m.MemberId)">@m.Name (@m.MemberCode)</MudSelectItem>
                    }
                </MudSelect>
            }

            @if (existingMembership is not null)
            {
                <div class="gmm-ms__existing-membership mt-3">
                    <MudText Typo="Typo.subtitle2" Class="gmm-ms__existing-title">Current Membership</MudText>
                    <div class="d-flex flex-wrap align-center" style="gap: 10px;">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                                 Color="@GetStatusColor(existingMembership.Status)" Class="gmm-ms__existing-chip">
                            @existingMembership.Status
                        </MudChip>
                        <MudText Typo="Typo.body2" Class="gmm-ms__existing-plan">
                            @existingMembership.PlanName
                        </MudText>
                        @if (IsExpiringSoon(existingMembership))
                        {
                            <MudText Typo="Typo.body2" Class="gmm-ms__soon">
                                @(DaysRemaining(existingMembership) == 0 ? "Expires today" : $"{DaysRemaining(existingMembership)} days left")
                            </MudText>
                        }
                    </div>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1">
                        @existingMembership.StartDate.ToString("yyyy-MM-dd") &rarr; @existingMembership.EndDate.ToString("yyyy-MM-dd")
                    </MudText>
                </div>
            }

            <MudText Typo="Typo.body2" Class="mb-1 gmm-ms__create-label">
                <strong>Plan</strong> <span class="text-danger">*</span>
            </MudText>
            <MudSelect T="int" Value="@request.MembershipPlanId" ValueChanged="@OnPlanValueChanged"
                       Label="Select a plan" Variant="Variant.Outlined" Required="true"
                       RequiredError="Please select a plan."
                       AnchorOrigin="Origin.BottomCenter" Class="gmm-field-constrained"
                       HelperText="Selecting a plan pre-fills the amount.">
                @foreach (var p in plans)
                {
                    <MudSelectItem Value="@(p.MemberShipPlanId)">@p.PlanName (@p.DurationDays days - @CurrencyFormatter.FormatMMK(p.Price))</MudSelectItem>
                }
            </MudSelect>

            @if (GetSelectedPlan() is { } selectedPlan)
            {
                <div class="gmm-ms__create-plan-summary mt-3">
                    <div class="gmm-ms__create-plan-row">
                        <span class="mud-text-secondary">
                            <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Class="mr-1" />Duration
                        </span>
                        <strong>@selectedPlan.DurationDays days</strong>
                    </div>
                    <div class="gmm-ms__create-plan-row">
                        <span class="mud-text-secondary">
                            <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Size="Size.Small" Class="mr-1" />Price
                        </span>
                        <strong>@CurrencyFormatter.FormatMMK(selectedPlan.Price)</strong>
                    </div>
                    <div class="gmm-ms__create-plan-row">
                        <span class="mud-text-secondary">
                            <MudIcon Icon="@Icons.Material.Filled.Event" Size="Size.Small" Class="mr-1" />End Date
                        </span>
                        <strong class="gmm-ms__create-plan-end">@(CalculatedEndDate?.ToString("yyyy-MM-dd") ?? "—")</strong>
                    </div>
                </div>
            }

            <MudDivider Class="my-4" />

            <MudText Typo="Typo.body2" Class="mb-1 gmm-ms__create-label">
                <strong>Payment Method</strong> <span class="text-danger">*</span>
            </MudText>
            <MudSelect T="int" Value="@request.PaymentMethodId" ValueChanged="@OnPaymentMethodValueChanged"
                       Label="Select payment method" Variant="Variant.Outlined" Required="true"
                       RequiredError="Please select a payment method."
                       AnchorOrigin="Origin.BottomCenter" Class="gmm-field-constrained"
                       HelperText="How the member paid for this membership.">
                @foreach (var pm in paymentMethods)
                {
                    <MudSelectItem Value="@(pm.PaymentMethodId)">@pm.Name</MudSelectItem>
                }
            </MudSelect>

            <MudNumericField @bind-Value="request.Amount" T="decimal" Label="Amount" Variant="Variant.Outlined"
                             Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.AttachMoney"
                             Min="0.01m" Step="0.01m" Class="gmm-field-constrained mt-3"
                             HelperText="Pre-filled from the plan price; adjust if needed." />
        }
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text" Class="mr-2">Cancel</MudButton>
        <MudButton OnClick="Save"
                   Variant="Variant.Filled"
                   Class="gmm-ms__create-save"
                   StartIcon="@Icons.Material.Filled.Save"
                   Disabled="@(isSaving || loadFailed)">
            @if (isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Create
        </MudButton>
    </DialogActions>
</MudDialog>

<style>
    .gmm-ms__create-title {
        font-weight: 700 !important;
    }

    .gmm-ms__create-label {
        color: var(--mud-palette-text-secondary);
    }

    .gmm-ms__create-skeleton {
        gap: 16px;
    }

    .gmm-ms__create-plan-summary {
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding: 12px 16px;
        border-radius: 12px;
        border: 1px solid var(--mud-palette-lines-default);
        background-color: var(--mud-palette-surface);
    }

    .gmm-ms__create-plan-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .gmm-ms__create-plan-end {
        color: #60A5FA;
        font-variant-numeric: tabular-nums;
    }

    .gmm-ms__create-save {
        background-color: #10B981;
        border-radius: 8px;
    }

    .gmm-ms__create-save:hover {
        filter: brightness(1.15);
    }

    .gmm-ms__existing-membership {
        padding: 12px 16px;
        border-radius: 12px;
        border: 1px solid var(--mud-palette-lines-default);
        background-color: var(--mud-palette-surface);
    }

    .gmm-ms__existing-title {
        color: var(--mud-palette-text-secondary);
        margin-bottom: 8px;
    }

    .gmm-ms__existing-plan {
        font-weight: 600;
    }

    .gmm-ms__existing-chip {
        border-radius: 6px;
    }

    .gmm-ms__soon {
        color: #F59E0B;
        font-weight: 600;
    }

    .gmm-field-constrained {
        flex: 0 1 320px !important;
        min-width: 200px !important;
        max-width: 320px !important;
        width: auto !important;
    }
</style>
