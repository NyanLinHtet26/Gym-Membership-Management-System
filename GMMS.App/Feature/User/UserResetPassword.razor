@using MudBlazor

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.LockReset" Class="mr-3" Color="Color.Warning" /> Reset Password
        </MudText>
    </TitleContent>

    <DialogContent>
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
        }

        <MudText Typo="Typo.body1" Class="mb-4">
            Resetting password for <strong>@UserName</strong>. The user will be required to change it on next login.
        </MudText>

        <MudTextField @bind-Value="newPassword"
                      Label="New Password"
                      Variant="Variant.Outlined"
                      InputType="InputType.Password"
                      Required="true"
                      RequiredError="New password is required."
                      Class="mb-3"
                      HelperText="Min 6 chars, must contain upper, lower, digit, and special char" />
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Cancel</MudButton>
        <MudButton OnClick="ConfirmReset"
                   Variant="Variant.Filled"
                   Color="Color.Warning"
                   Disabled="@isLoading">
            @if (isLoading)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Reset Password
        </MudButton>
    </DialogActions>
</MudDialog>
