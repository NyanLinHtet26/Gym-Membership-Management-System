@page "/login"

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex flex-column justify-center" Style="min-height: 80vh;">
    <MudPaper Class="pa-8" Elevation="4">
        <MudText Typo="Typo.h4" Class="text-center mb-6" Style="font-weight: 700;">
            Gym Management System
        </MudText>

        <MudText Typo="Typo.h6" Class="text-center mud-text-secondary mb-6">
            Sign In
        </MudText>

        @if (errorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
        }

        <MudTextField @bind-Value="userName" Label="Username" Variant="Variant.Outlined" Class="mb-4" For="@(() => userName)" />
        <MudTextField @bind-Value="password" Label="Password" Variant="Variant.Outlined" InputType="InputType.Password" Class="mb-6" For="@(() => password)" />

        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="HandleLogin" Disabled="isLoading" Class="mb-4" Size="Size.Large">
            @if (isLoading)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
            }
            Sign In
        </MudButton>
    </MudPaper>
</MudContainer>
