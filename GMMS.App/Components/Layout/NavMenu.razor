@namespace GMMS.App.Components.Layout

<MudPaper Width="250px" Elevation="0" Class="gmm-nav-dark d-flex flex-column" Style="background-color: transparent; color: #fff; height:100%;">
    <MudNavMenu Rounded="true" Margin="Margin.Dense" Color="Color.Primary" Class="pa-2">
        <MudNavLink Href="member-list" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.People">Members</MudNavLink>
        <MudNavLink Href="membership-list-all" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.HowToReg">All Memberships</MudNavLink>
        <MudNavLink Href="membershipplan-list" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Book">Membership Plans</MudNavLink>
        <MudNavLink Href="paymentmethod-list" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Wallet">Payment Methods</MudNavLink>
        <MudNavLink Href="payment-list" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Receipt">Payments</MudNavLink>
        @if (AuthTokenStore.CurrentUser?.Role == "Owner")
        {
            <MudNavLink Href="user-list" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AdminPanelSettings">Users</MudNavLink>
        }
    </MudNavMenu>

    <div class="px-2 pb-3 mt-auto">
        <MudDivider Style="background-color: rgba(255,255,255,0.12);" Class="mb-3" />
        <MudMenu AnchorOrigin="Origin.TopLeft" TransformOrigin="Origin.BottomLeft" Style="width:100%;"
                 @bind-Open="_accountMenuOpen" PopoverClass="gmm-nav-popover">
            <ActivatorContent>
                <div class="gmm-nav-account @(_accountMenuOpen ? "gmm-nav-account--open" : "")" @onclick="context.ToggleAsync">
                    <MudAvatar Size="Size.Small" Style="background-color:#2A2A2A; color:#fff; border:1px solid rgba(255,255,255,0.15);">@Initial</MudAvatar>
                    <div class="gmm-nav-account__info">
                        <MudText Typo="Typo.body2" Class="gmm-nav-account__name">@AuthTokenStore.CurrentUser?.UserName</MudText>
                        <MudText Typo="Typo.caption" Class="gmm-nav-role">@RoleLabel</MudText>
                    </div>
                    <MudIconButton Icon="@Icons.Material.Filled.MoreHoriz" Size="Size.Small" Class="gmm-nav-account__more" aria-label="Account options" />
                </div>
            </ActivatorContent>
            <ChildContent>
                <div class="gmm-nav-popover__header">
                    <MudAvatar Size="Size.Small" Style="background-color:#2A2A2A; color:#fff; border:1px solid rgba(255,255,255,0.15);">@Initial</MudAvatar>
                    <div class="gmm-nav-popover__meta">
                        <MudText Typo="Typo.body2" Class="gmm-nav-popover__name">@AuthTokenStore.CurrentUser?.UserName</MudText>
                        <MudText Typo="Typo.caption" Class="gmm-nav-role">@RoleLabel</MudText>
                    </div>
                </div>
                <MudDivider />
                <MudMenuItem OnClick="GoToChangePassword" Icon="@Icons.Material.Filled.LockReset">Change Password</MudMenuItem>
                <MudDivider />
                <MudMenuItem OnClick="HandleLogout" Icon="@Icons.Material.Filled.Logout" Class="gmm-nav-logout" Style="color:#A78BFA;">Log out</MudMenuItem>
            </ChildContent>
        </MudMenu>
    </div>
</MudPaper>
