@page "/membership-list"
@using GMMS.App.Components.Common

<MudContainer MaxWidth="MaxWidth.Large">
    <div class="gmm-ms__head">
        <div>
            <MudText Typo="Typo.h4" Class="gmm-ms__title">Memberships</MudText>
            <MudText Typo="Typo.body2" Class="gmm-ms__subtitle">Track this member's plans, expiry dates and status.</MudText>
        </div>
        @if (AuthTokenStore.CurrentUser?.Role != AuthTokenStore.RoleOwner)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="gmm-ms__add"
                       OnClick="OpenCreateDialog" StartIcon="@Icons.Material.Filled.Add">
                New Membership
            </MudButton>
        }
    </div>

    <div class="gmm-ms__stats">
        <div class="gmm-ms__stat">
            <MudIcon Icon="@Icons.Material.Filled.CardMembership" Class="gmm-ms__stat-icon" />
            <div>
                <MudText Typo="Typo.h6" Class="gmm-ms__stat-value">@totalCount</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Total Memberships</MudText>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <MudPaper Elevation="0" Outlined="true" Class="gmm-ms__table gmm-ms__skeleton">
            <div class="pa-4 d-flex flex-column gmm-ms__skeleton-rows">
                @for (var i = 0; i < 6; i++)
                {
                    <div class="d-flex align-center gmm-ms__skeleton-row gmm-ms__skeleton-row--member">
                        <MudSkeleton Width="40px" Height="22px" />
                        <MudSkeleton Width="200px" Height="22px" />
                        <MudSkeleton Width="110px" Height="22px" />
                        <MudSkeleton Width="110px" Height="22px" />
                        <MudSkeleton Width="80px" Height="22px" />
                        <MudSkeleton Width="110px" Height="22px" />
                    </div>
                }
            </div>
        </MudPaper>
    }
    else if (errorMessage is not null)
    {
        <MudPaper Elevation="0" Outlined="true" Class="gmm-ms__error pa-6 d-flex flex-column align-center">
            <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Large" Class="mud-text-secondary mb-3" />
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="w-100">
                @errorMessage
            </MudAlert>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-3">
                Check your connection to the server, then try again.
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="gmm-ms__retry mt-4"
                       OnClick="RetryAsync" StartIcon="@Icons.Material.Filled.Refresh">
                Try Again
            </MudButton>
        </MudPaper>
    }
    else if (memberships is not null && memberships.Count > 0)
    {
        <MudPaper Elevation="0" Outlined="true" Class="gmm-ms__table">
            <MudTable Items="memberships" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh Style="width: 56px;">#</MudTh>
                    <MudTh>Plan</MudTh>
                    <MudTh>Start Date</MudTh>
                    <MudTh>End Date</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh Style="text-align: right;">Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="#" Style="color: var(--mud-palette-text-secondary);">@context.MembershipId</MudTd>
                    <MudTd DataLabel="Plan">
                        <div class="d-flex flex-column">
                            <span><TruncatedText Text="@context.PlanName" MaxLength="35" MaxWidth="220px" /></span>
                            <small class="mud-text-secondary"><TruncatedText Text="@context.PlanCode" MaxLength="20" MaxWidth="200px" /></small>
                        </div>
                    </MudTd>
                    <MudTd DataLabel="Start Date" Style="color: var(--mud-palette-text-secondary); white-space: nowrap;">
                        <div class="d-flex align-center">
                            <MudIcon Icon="@Icons.Material.Filled.Event" Size="Size.Small" Class="mr-1 gmm-ms__date-icon" />
                            <span>@context.StartDate.ToString("d")</span>
                        </div>
                    </MudTd>
                    <MudTd DataLabel="End Date" Style="white-space: nowrap;">
                        <div class="d-flex align-center">
                            <MudIcon Icon="@GetEndIcon(context)" Size="Size.Small" Class="@($"mr-1 {GetEndIconClass(context)}")" />
                            <span>@context.EndDate.ToString("d")</span>
                        </div>
                        @if (GetEndNote(context) is { } note)
                        {
                            <MudText Typo="Typo.caption" Class="@GetEndNoteClass(context)">@note</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="Status">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@GetStatusColor(context.Status)" Class="gmm-ms__chip">
                            @context.Status
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Actions" Style="text-align: right; white-space: nowrap;">
                        <MudTooltip Text="View details">
                            <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Info"
                                           OnClick="@(() => OpenDetailDialog(context.MembershipId))" Size="Size.Small" />
                        </MudTooltip>
                        @if (AuthTokenStore.CurrentUser?.Role != AuthTokenStore.RoleOwner)
                        {
                            <MudTooltip Text="Edit membership">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary"
                                               OnClick="@(() => OpenEditDialog(context.MembershipId))" Size="Size.Small" />
                            </MudTooltip>
                            <MudTooltip Text="Delete membership">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                               OnClick="@(() => OpenDeleteDialog(context.MembershipId))" Size="Size.Small" />
                            </MudTooltip>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>

        <div class="gmm-ms__pagination">
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                Page @_pageSelected of @totalPages · @totalCount memberships
            </MudText>
            <MudPagination BoundaryCount="1" MiddleCount="1" Count="@totalPages" Selected="@_pageSelected" SelectedChanged="PageChanged" />
        </div>
    }
    else
    {
        <MudPaper Elevation="0" Outlined="true" Class="gmm-ms__empty pa-8 d-flex flex-column align-center">
            <MudIcon Icon="@Icons.Material.Filled.CardMembership" Size="Size.Large" Class="mud-text-secondary mb-3" />
            <MudText Typo="Typo.body1" Class="mb-1"><strong>No memberships yet</strong></MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="text-align: center; max-width: 420px;">
                This member doesn't have any memberships yet. Add the first one to get started.
            </MudText>
            @if (AuthTokenStore.CurrentUser?.Role != AuthTokenStore.RoleOwner)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="gmm-ms__add mt-4"
                           OnClick="OpenCreateDialog" StartIcon="@Icons.Material.Filled.Add">
                    New Membership
                </MudButton>
            }
        </MudPaper>
    }
</MudContainer>

<style>
    .gmm-ms__head {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 8px;
    }

    .gmm-ms__title {
        font-weight: 700 !important;
        text-wrap: balance;
    }

    .gmm-ms__subtitle {
        color: var(--mud-palette-text-secondary);
        text-wrap: pretty;
    }

    .gmm-ms__add {
        background-color: #10B981;
        border-radius: 8px;
    }

    .gmm-ms__add:hover {
        filter: brightness(1.15);
    }

    .gmm-ms__retry {
        background-color: var(--mud-palette-primary);
        border-radius: 8px;
    }

    .gmm-ms__stats {
        margin: 20px 0;
    }

    .gmm-ms__stat {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        padding: 14px 20px;
        border-radius: 12px;
        border: 1px solid var(--mud-palette-lines-default);
        background-color: var(--mud-palette-surface);
    }

    .gmm-ms__stat-icon {
        color: #60A5FA;
    }

    .gmm-ms__stat-value {
        color: #60A5FA;
        margin: 0;
        line-height: 1;
        font-variant-numeric: tabular-nums;
    }

    .gmm-ms__table {
        margin-top: 8px;
        border-radius: 12px;
        overflow: hidden;
    }

    .gmm-ms__table .mud-table-body td {
        font-variant-numeric: tabular-nums;
    }

    .gmm-ms__chip {
        border-radius: 6px;
    }

    .gmm-ms__date-icon {
        color: var(--mud-palette-text-secondary);
    }

    .gmm-ms__icon-ok {
        color: #10B981;
    }

    .gmm-ms__icon-warn {
        color: #F59E0B;
    }

    .gmm-ms__icon-error {
        color: #EF4444;
    }

    .gmm-ms__remaining {
        color: var(--mud-palette-text-secondary);
    }

    .gmm-ms__soon {
        color: #F59E0B;
        font-weight: 600;
    }

    .gmm-ms__overdue {
        color: #EF4444;
        font-weight: 600;
    }

    .gmm-ms__pagination {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-top: 16px;
    }

    .gmm-ms__error {
        margin-top: 8px;
        border-radius: 12px;
    }

    .gmm-ms__skeleton-rows {
        gap: 16px;
    }

    .gmm-ms__skeleton-row {
        gap: 32px;
    }

    .gmm-ms__skeleton-row .mud-skeleton:nth-child(1) {
        flex: 0 0 40px;
    }

    .gmm-ms__skeleton-row .mud-skeleton:nth-child(2) {
        flex: 1 1 200px;
    }

    .gmm-ms__skeleton-row .mud-skeleton:nth-child(3) {
        flex: 0 0 110px;
    }

    .gmm-ms__skeleton-row .mud-skeleton:nth-child(4) {
        flex: 0 0 110px;
    }

    .gmm-ms__skeleton-row .mud-skeleton:nth-child(5) {
        flex: 0 0 80px;
    }

    .gmm-ms__skeleton-row .mud-skeleton:nth-child(6) {
        flex: 0 0 110px;
    }

    .gmm-ms__empty {
        margin-top: 24px;
        border-radius: 12px;
    }
</style>
