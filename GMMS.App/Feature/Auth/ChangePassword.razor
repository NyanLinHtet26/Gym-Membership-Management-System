@page "/change-password"
@layout AuthLayout
@using Microsoft.AspNetCore.Components.Web

<div class="gmm-login-page">
    <div class="gmm-login-card">
        <div class="text-center mb-6">
            <img src="logo.svg" alt="Gym Logo" class="mb-3" style="height: 56px; width: 56px;" />
            <MudText Typo="Typo.h4" Class="mb-1" Style="font-weight: 700; color: #111;">
                Change Password
            </MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                Update your account password
            </MudText>
        </div>

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <MudAlert Severity="Severity.Success" Class="mb-4">@successMessage</MudAlert>
        }

        @if (errorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
        }

        <div @onkeydown="HandleEnterKey">
            <MudTextField @bind-Value="currentPassword" Label="Current Password" Variant="Variant.Outlined" Class="mb-4"
                          InputType="@(showCurrent ? InputType.Text : InputType.Password)"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(showCurrent ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          OnAdornmentClick="ToggleCurrent"
                          For="@(() => currentPassword)" />
            <MudTextField @bind-Value="newPassword" Label="New Password" Variant="Variant.Outlined" Class="mb-4"
                          InputType="@(showNew ? InputType.Text : InputType.Password)"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(showNew ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          OnAdornmentClick="ToggleNew"
                          For="@(() => newPassword)" />
            <MudTextField @bind-Value="confirmNewPassword" Label="Confirm New Password" Variant="Variant.Outlined" Class="mb-6"
                          InputType="@(showConfirm ? InputType.Text : InputType.Password)"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(showConfirm ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          OnAdornmentClick="ToggleConfirm"
                          For="@(() => confirmNewPassword)" />

            <MudButton Variant="Variant.Filled" FullWidth="true" OnClick="HandleChangePassword" Disabled="isLoading" Size="Size.Large" Class="gmm-login-btn mb-2">
                @if (isLoading)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Inherit" Class="mr-2" />
                }
                Change Password
            </MudButton>

            <div class="text-center mt-2">
                <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Cancel">Cancel</MudButton>
            </div>
        </div>
    </div>
</div>

<style>
    .gmm-login-page {
        position: fixed;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px;
        overflow: auto;
        background-color: #0D0A12;
        background-image:
            radial-gradient(ellipse at 50% 12%, rgba(255, 46, 147, 0.14) 0%, transparent 55%),
            linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
        background-size: 100% 100%, 60px 60px, 60px 60px;
    }

    .gmm-login-card {
        width: 100%;
        max-width: 420px;
        background-color: #ffffff;
        border-radius: 16px;
        padding: 40px 36px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.55), 0 0 40px rgba(255, 46, 147, 0.12);
        animation: gmm-fade-up 0.35s ease-out;
    }

    .gmm-login-btn {
        background-color: #FF2E93 !important;
        color: #fff !important;
    }

    .gmm-login-btn:hover {
        background-color: #D61F7A !important;
    }

    @@keyframes gmm-fade-up {
        from {
            opacity: 0;
            transform: translateY(16px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
