@using MudBlazor

<MudDialog MaxWidth="MaxWidth.Small" FullWidth="true">
    <TitleContent>
        <MudText Typo="Typo.h6" Class="gmm-ms__delete-title">
            <MudIcon Icon="@Icons.Material.Filled.Delete" Class="mr-3" Color="Color.Error" /> Delete Membership
        </MudText>
    </TitleContent>

    <DialogContent>
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
        }

        @if (isLoading)
        {
            <div class="d-flex flex-column gmm-ms__delete-skeleton">
                <MudSkeleton Height="56px" />
                <MudSkeleton Height="56px" />
                <MudSkeleton Height="56px" />
            </div>
        }
        else if (loadFailed)
        {
            <div class="d-flex flex-column align-center pa-4">
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3" Style="text-align: center;">
                    We couldn't load this membership. Check your connection, then try again.
                </MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RetryAsync"
                           StartIcon="@Icons.Material.Filled.Refresh">
                    Try Again
                </MudButton>
            </div>
        }
        else if (membership is not null)
        {
            <div class="d-flex flex-wrap align-center mb-3" style="gap: 12px;">
                <MudTextField Value="@membership.MemberName" Label="Member" Variant="Variant.Outlined"
                              ReadOnly="true" Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Person" Class="gmm-field-constrained" />
                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Class="gmm-ms__delete-code">@membership.MemberCode</MudChip>
            </div>

            <div class="d-flex flex-wrap align-center mb-3" style="gap: 12px;">
                <MudTextField Value="@membership.PlanName" Label="Plan" Variant="Variant.Outlined"
                              ReadOnly="true" Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Subscriptions" Class="gmm-field-constrained" />
                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Class="gmm-ms__delete-code">@membership.PlanCode</MudChip>
            </div>

            <div class="d-flex flex-wrap mb-3" style="gap: 12px;">
                <MudTextField Value="@membership.StartDate.ToString("yyyy-MM-dd")" Label="Start Date"
                              Variant="Variant.Outlined" ReadOnly="true"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.CalendarToday"
                              Class="gmm-field-date" />
                <MudTextField Value="@membership.EndDate.ToString("yyyy-MM-dd")" Label="End Date"
                              Variant="Variant.Outlined" ReadOnly="true"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.EventAvailable"
                              Class="gmm-field-date" />
            </div>

            <div class="mb-4">
                <MudText Typo="Typo.body2" Class="mb-1 gmm-ms__delete-label">Status</MudText>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@GetStatusColor(membership.Status)" Class="gmm-ms__delete-chip">
                    @membership.Status
                </MudChip>
            </div>

            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4">
                <div class="d-flex flex-column" style="gap: 4px;">
                    <span><strong>This action cannot be undone.</strong></span>
                    <span>The member will lose access to this plan immediately.</span>
                    <span>Related payments will be preserved for records.</span>
                </div>
            </MudAlert>

            <MudCheckBox @bind-Value="confirmed" Color="Color.Error" Class="gmm-ms__delete-confirm"
                         Label="I understand this will permanently delete this membership." />
        }
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text" Class="mr-2">Cancel</MudButton>
        <MudButton OnClick="ConfirmDelete"
                   Variant="Variant.Filled"
                   Color="Color.Error"
                   Class="gmm-ms__delete-btn"
                   Disabled="@(isDeleting || !confirmed || membership is null)">
            @if (isDeleting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Yes, Delete
        </MudButton>
    </DialogActions>
</MudDialog>

<style>
    .gmm-ms__delete-title {
        font-weight: 700 !important;
    }

    .gmm-ms__delete-label {
        color: var(--mud-palette-text-secondary);
    }

    .gmm-ms__delete-skeleton {
        gap: 16px;
    }

    .gmm-ms__delete-code.mud-chip {
        background-color: var(--mud-palette-background-grey);
        color: var(--mud-palette-text-primary);
        border-left: 3px solid #60A5FA;
        border-radius: 6px;
        font-family: 'Cascadia Mono', 'Consolas', monospace;
        letter-spacing: .3px;
    }

    .gmm-ms__delete-chip {
        border-radius: 6px;
    }

    .gmm-ms__delete-confirm {
        margin-top: 4px;
    }

    .gmm-ms__delete-btn {
        border-radius: 8px;
    }

    .gmm-field-constrained {
        flex: 0 1 320px !important;
        min-width: 200px !important;
        max-width: 320px !important;
        width: auto !important;
    }

    .gmm-field-date {
        flex: 0 0 180px !important;
        max-width: 180px !important;
        min-width: 160px !important;
        width: auto !important;
    }
</style>
