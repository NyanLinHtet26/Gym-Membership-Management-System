@page "/user-list"

<MudContainer MaxWidth="MaxWidth.Large">
    <div class="gmm-user__head">
        <div>
            <MudText Typo="Typo.h4" Class="gmm-user__title">Users</MudText>
            <MudText Typo="Typo.body2" Class="gmm-user__subtitle">Manage accounts, roles and access to the gym system.</MudText>
        </div>
        @if (AuthTokenStore.CurrentUser?.Role == AuthTokenStore.RoleOwner)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="gmm-user__add"
                       OnClick="OpenCreateDialog" StartIcon="@Icons.Material.Filled.PersonAdd">
                Create User
            </MudButton>
        }
    </div>

    <div class="gmm-user__stats">
        <div class="gmm-user__stat">
            <MudIcon Icon="@Icons.Material.Filled.ManageAccounts" Class="gmm-user__stat-icon" />
            <div>
                <MudText Typo="Typo.h6" Class="gmm-user__stat-value">@totalCount</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Total Users</MudText>
            </div>
        </div>
    </div>

    <MudTextField @bind-Value="searchTerm"
                  Placeholder="Search by username or role..."
                  Variant="Variant.Outlined"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Clearable="true"
                  Immediate="true"
                  Class="gmm-field-search" />

    @if (isLoading)
    {
        <MudPaper Elevation="0" Outlined="true" Class="gmm-user__table gmm-user__skeleton">
            <div class="pa-4 d-flex flex-column gmm-user__skeleton-rows">
                @for (var i = 0; i < 6; i++)
                {
                    <div class="d-flex align-center gmm-user__skeleton-row">
                        <MudSkeleton Width="40px" Height="22px" />
                        <MudSkeleton Width="180px" Height="22px" />
                        <MudSkeleton Width="90px" Height="22px" />
                        <MudSkeleton Width="80px" Height="22px" />
                        <MudSkeleton Width="150px" Height="22px" />
                        <MudSkeleton Width="120px" Height="22px" />
                    </div>
                }
            </div>
        </MudPaper>
    }
    else if (errorMessage is not null)
    {
        <MudPaper Elevation="0" Outlined="true" Class="gmm-user__error pa-6 d-flex flex-column align-center">
            <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Large" Class="mud-text-secondary mb-3" />
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="w-100">
                @errorMessage
            </MudAlert>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-3">
                Check your connection to the server, then try again.
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="gmm-user__create mt-4"
                       OnClick="RetryAsync" StartIcon="@Icons.Material.Filled.Refresh">
                Try Again
            </MudButton>
        </MudPaper>
    }
    else if (users is not null && users.Count > 0)
    {
        <MudPaper Elevation="0" Outlined="true" Class="gmm-user__table">
            <MudTable Items="users" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh Style="width: 56px;">#</MudTh>
                    <MudTh>Username</MudTh>
                    <MudTh>Role</MudTh>
                    <MudTh>Active</MudTh>
                    <MudTh>Created At</MudTh>
                    <MudTh Style="text-align: right;">Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="#" Style="color: var(--mud-palette-text-secondary);">@context.UserId</MudTd>
                    <MudTd DataLabel="Username">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Class="gmm-user__code">@context.UserName</MudChip>
                    </MudTd>
                    <MudTd DataLabel="Role">
                        <MudChip T="string" Size="Size.Small" Class="gmm-user__role-chip"
                                 Color="@(context.Role == "Owner" ? Color.Warning : Color.Primary)">
                            @context.Role
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Active">
                        <MudIcon Icon="@(context.IsActive ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)"
                                 Color="@(context.IsActive ? Color.Success : Color.Error)" Size="Size.Small" />
                    </MudTd>
                    <MudTd DataLabel="Created At" Style="color: var(--mud-palette-text-secondary);">
                        @context.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                    </MudTd>
                    <MudTd DataLabel="Actions" Style="text-align: right; white-space: nowrap;">
                        @if (AuthTokenStore.CurrentUser?.Role == AuthTokenStore.RoleOwner)
                        {
                            <MudTooltip Text="Edit user">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary"
                                               OnClick="@(() => OpenEditDialog(context.UserId))" Size="Size.Small" />
                            </MudTooltip>
                            <MudTooltip Text="Reset password">
                                <MudIconButton Icon="@Icons.Material.Filled.LockReset" Color="Color.Warning"
                                               OnClick="@(() => OpenResetPasswordDialog(context.UserId, context.UserName))" Size="Size.Small" />
                            </MudTooltip>
                            <MudTooltip Text="Delete user">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                               OnClick="@(() => OpenDeleteDialog(context.UserId))" Size="Size.Small" />
                            </MudTooltip>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>

        <div class="gmm-user__pagination">
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                Page @_pageSelected of @totalPages · @totalCount users
            </MudText>
            <MudPagination BoundaryCount="1" MiddleCount="1" Count="@totalPages" Selected="@_pageSelected" SelectedChanged="PageChanged" />
        </div>
    }
    else
    {
        <MudPaper Elevation="0" Outlined="true" Class="gmm-user__empty pa-8 d-flex flex-column align-center">
            <MudIcon Icon="@Icons.Material.Filled.PersonSearch" Size="Size.Large" Class="mud-text-secondary mb-3" />
            <MudText Typo="Typo.body1" Class="mb-1"><strong>No users found</strong></MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="text-align: center; max-width: 420px;">
                @(string.IsNullOrWhiteSpace(_searchTerm)
                    ? "You haven't created any users yet. Add the first one to get started."
                    : $"Nothing matches \"{_searchTerm}\". Try a different username or role.")
            </MudText>
            @if (string.IsNullOrWhiteSpace(_searchTerm) && AuthTokenStore.CurrentUser?.Role == AuthTokenStore.RoleOwner)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="gmm-user__add mt-4"
                           OnClick="OpenCreateDialog" StartIcon="@Icons.Material.Filled.PersonAdd">
                    Create User
                </MudButton>
            }
        </MudPaper>
    }
</MudContainer>

<style>
    .gmm-user__head {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 8px;
    }

    .gmm-user__title {
        font-weight: 700 !important;
        text-wrap: balance;
    }

    .gmm-user__subtitle {
        color: var(--mud-palette-text-secondary);
        text-wrap: pretty;
    }

    .gmm-user__create {
        background-color: var(--mud-palette-primary);
        border-radius: 8px;
    }

    .gmm-user__create:hover {
        filter: brightness(1.15);
    }

    .gmm-user__add {
        background-color: #10B981;
        border-radius: 8px;
    }

    .gmm-user__add:hover {
        filter: brightness(1.15);
    }

    .gmm-user__stats {
        margin: 20px 0;
    }

    .gmm-user__stat {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        padding: 14px 20px;
        border-radius: 12px;
        border: 1px solid var(--mud-palette-lines-default);
        background-color: var(--mud-palette-surface);
    }

    .gmm-user__stat-icon {
        color: #A78BFA;
    }

    .gmm-user__stat-value {
        color: #A78BFA;
        margin: 0;
        line-height: 1;
        font-variant-numeric: tabular-nums;
    }

    .gmm-user__table {
        margin-top: 8px;
        border-radius: 12px;
        overflow: hidden;
    }

    .gmm-user__table .mud-table-body td {
        font-variant-numeric: tabular-nums;
    }

    .gmm-user__code.mud-chip {
        background-color: var(--mud-palette-background-grey);
        color: var(--mud-palette-text-primary);
        border-left: 3px solid #A78BFA;
        border-radius: 6px;
        font-family: 'Cascadia Mono', 'Consolas', monospace;
        letter-spacing: .3px;
    }

    .gmm-user__role-chip {
        border-radius: 6px;
    }

    .gmm-user__pagination {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-top: 16px;
    }

    .gmm-user__error {
        margin-top: 8px;
        border-radius: 12px;
    }

    .gmm-user__skeleton-rows {
        gap: 16px;
    }

    .gmm-user__skeleton-row {
        gap: 32px;
    }

    .gmm-user__skeleton-row .mud-skeleton:nth-child(1) {
        flex: 0 0 40px;
    }

    .gmm-user__skeleton-row .mud-skeleton:nth-child(2) {
        flex: 1 1 180px;
    }

    .gmm-user__skeleton-row .mud-skeleton:nth-child(3) {
        flex: 0 0 90px;
    }

    .gmm-user__skeleton-row .mud-skeleton:nth-child(4) {
        flex: 0 0 80px;
    }

    .gmm-user__skeleton-row .mud-skeleton:nth-child(5) {
        flex: 0 0 150px;
    }

    .gmm-user__skeleton-row .mud-skeleton:nth-child(6) {
        flex: 0 0 120px;
    }

    .gmm-user__empty {
        margin-top: 24px;
        border-radius: 12px;
    }

    .gmm-field-search {
        flex: 0 1 320px !important;
        min-width: 220px !important;
        max-width: 400px !important;
        width: auto !important;
    }
</style>
